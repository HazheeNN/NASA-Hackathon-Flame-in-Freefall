# Names only. Real values go in your own .env.local (never committed) and in Vercel.
# Anthropic API key from console.anthropic.com (pay as you go). A Claude Pro subscription
# does NOT include API access: see docs/runbook.md. Server only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional. Overrides the model in src/lib/claude.ts (default claude-opus-5-5).
CLAUDE_MODEL=
# Optional. "off" turns the live Ask box off and the app shows the pre-built answers only
# (use it if the key runs out or the API is slow during judging).
LIVE_SI=
