# Names only. Real values go in your own .env.local (never committed) and in Vercel.
#
# NOT NEEDED right now: the team runs the SI in Claude Code sessions (mode A, docs/ai.md),
# and the app works without any key. These are for the optional API mode (mode B), if we
# get an Anthropic API key later. A Claude Pro subscription does NOT include API access.
#
# Anthropic API key from console.anthropic.com (pay as you go). Server only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional. Overrides the model in src/lib/claude.ts (default claude-opus-5-5).
CLAUDE_MODEL=
# Optional, mode B only. "off" turns the live Ask off even when a key is set.
LIVE_SI=
