{
  "name": "flame-in-freefall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "data:validate": "tsx scripts/validate-data.mts",
    "data:ntrs": "tsx scripts/fetch-ntrs.mts",
    "data:flex": "tsx scripts/flex-table-ix.mts",
    "si:build": "node --env-file-if-exists=.env.local --import tsx scripts/build-insights.mts",
    "si:extract": "node --env-file-if-exists=.env.local --import tsx scripts/extract-findings.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
